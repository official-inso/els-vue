{
  "name": "@inso_web/els-vue",
  "version": "0.5.1",
  "description": "Vue 3 plugin для Error Logs Service (ELS): глобальный errorHandler, composable useELS и автоматический репорт ошибок компонентов.",
  "homepage": "https://api.insoweb.ru/els",
  "author": "INSOWEB",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "docs", "examples", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "vue",
    "vue3",
    "plugin",
    "error-tracking",
    "error-monitoring",
    "observability",
    "sentry-alternative",
    "monitoring",
    "logging",
    "typescript",
    "els",
    "inso"
  ],
  "license": "MIT",
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "dependencies": {
    "@inso_web/els-client": "^0.5.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.3",
    "jsdom": "^23.0.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "vue": "^3.4.0"
  }
}
